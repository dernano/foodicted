{
  "name": "foodicted-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Foodicted backend API - fridge image analysis and AI recipe generation",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "cors": "^2.8.5",
