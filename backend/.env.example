# Anthropic API key - get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Server port
PORT=4000

# Comma-separated list of allowed CORS origins (use * for dev)
CORS_ORIGIN=*

# Optional: live email notification whenever the API is used (scan/generate/refine).
# Leave unset to disable - notifications are silently skipped if not configured.
# NOTIFY_EMAIL_USER/NOTIFY_EMAIL_APP_PASSWORD is a Gmail account + App Password
# (Google Account > Security > App passwords), used only to send these emails.
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_USER=your-gmail@gmail.com
NOTIFY_EMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
